aws_region = "eu-west-1"
database_name = "quickserve"

# Use the Route 53 zone ID when DNS is managed in this AWS account. Otherwise,
# leave it null and provide a validated eu-west-1 ACM certificate ARN.
route53_zone_id    = "Z0123456789EXAMPLE"
acm_certificate_arn = null

domain_name = "backend.quickserve.com.ng"
alert_email = "operations@quickserve.com.ng"
email_from  = "QuickServe <quickserve.example@gmail.com>"
email_reply_to = "support@quickserve.com.ng"

# Copy the current official production source IP list from Monnify documentation.
monnify_webhook_ips = "replace-with-official-monnify-ip-list"

monthly_budget_usd = 250

# Keep disabled until Monnify issues production credentials and the runtime
# secret contains the four MONNIFY_* keys documented in README.md.
enable_monnify = false

# First apply must remain false. Enable only after pushing image_tag, populating
# both secrets, creating least-privilege DB roles, and running migrations.
deploy_services = false
image_tag        = "replace-with-git-commit-sha"

# Set false and apply immediately after the DB role bootstrap task succeeds.
enable_database_bootstrap = true

# Production defaults. Do not disable these merely to reduce cost.
db_multi_az                  = true
db_deletion_protection       = true
enable_deletion_protection   = true
enable_waf                   = true
enable_container_insights    = false
